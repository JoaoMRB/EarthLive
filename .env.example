# OpenSky Network (recomendado — 4000 req/dia com conta)
# Sem isto, voos mostram ~100 req/dia (rate limit anónimo)
# Registo: https://opensky-network.org/
OPENSKY_USER=
OPENSKY_PASS=

# NASA FIRMS — mapa de incêndios via satélite
# Sem isto, a camada "fires" fica vazia na API (warning no log)
# 
# Como obter a chave (gratuita):
# 1. Regista-te em https://www.earthdata.nasa.gov/ (NASA account)
# 2. Acede a https://firms.modaps.eosdis.nasa.gov/api/
# 3. Cria uma "MAP_KEY" (gera uma token única)
# 4. Cola aqui: NASA_FIRMS_KEY=a1b2c3d4-e5f6-...
#
# Dados: até 7 dias, VIIRS Suomi NPP + Noaa-20 (satélites)
# Latência: ~3-4h desde captura até disponibilidade
# Para testar: GET http://localhost:3000/api/earth-data (procura "fires")
NASA_FIRMS_KEY=

# API server
PORT=3000
CORS_ORIGINS=http://localhost:4200

# Redis Cache (opcional — fallback automático para cache em memória se não configurado)
# Exemplo local: redis://localhost:6379 ou redis://127.0.0.1:6379
REDIS_URL=

# Supabase (opcional — utilizadores, preferências, favoritos)
# Se deixado vazio, o projeto funciona sem BD (todos os dados públicos)
# Registo: https://supabase.com/
SUPABASE_URL=
SUPABASE_ANON_KEY=
