# Copy to .env.local for local development (never commit .env.local).
#
# Everything prefixed with VITE_ is embedded in the public website bundle,
# so only put PUBLIC values here — never passwords or API keys.

# Optional — option B (real-time flights through your Cloudflare Worker).
# Local Worker: npm run worker:dev  → http://127.0.0.1:8787/flights
# Leave empty to use only the 15-minute snapshots (option A).
VITE_FLIGHTS_LIVE_URL=

# ---------------------------------------------------------------------------
# Secrets do NOT go in this file. They live only in:
#   • GitHub → Settings → Secrets and variables → Actions
#       OPENSKY_CLIENT_ID, OPENSKY_CLIENT_SECRET   (optional)
#   • Cloudflare Worker secrets (npx wrangler secret put …)
# For running `npm run data` locally with credentials, export them in your
# shell for that command only.
