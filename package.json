{
  "name": "earthlive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live Earth data (flights, earthquakes, wildfires, ISS) on a globe or flat map.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data": "node scripts/fetch-data.mjs public/data",
    "worker:dev": "npx wrangler@4.165.0 dev --config worker/wrangler.toml",
    "worker:deploy": "npx wrangler@4.165.0 deploy --config worker/wrangler.toml"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "satellite.js": "^6.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
