{
  "id": "./",
  "name": "EarthLive",
  "short_name": "EarthLive",
  "description": "The world seen from above, live: flights, earthquakes, wildfires, volcanoes, storms, wind, clouds, night lights and the ISS.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0B0C0E",
  "theme_color": "#0B0C0E",
  "categories": ["weather", "travel", "education", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/wide-wind.png", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "Animated wind on the globe" },
    { "src": "screenshots/wide-lights.png", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "Night lights compared side by side" },
    { "src": "screenshots/narrow-wind.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Animated wind on a phone" },
    { "src": "screenshots/narrow-lights.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Night lights on a phone" }
  ]
}
